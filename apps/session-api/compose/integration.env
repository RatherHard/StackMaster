# 容器门控集成测试环境(test:integration 经 node --env-file 注入)。
# 值域与 compose/deps.yaml、compose/.env.example 一致;均为本地开发专用值。
# 会话级开关:SESSION_API_IT=1 才连接真实容器,否则集成测试整体跳过并输出
# 跳过原因(单元测试只使用内存实现,无条件运行)。

SESSION_API_IT=1
SESSION_API_POSTGRES_URL=postgres://stackmaster:stackmaster-dev@127.0.0.1:15432/session_api
SESSION_API_REDIS_URL=redis://127.0.0.1:16379/0
SESSION_API_MINIO_ENDPOINT=127.0.0.1
SESSION_API_MINIO_PORT=19000
SESSION_API_MINIO_ACCESS_KEY=stackmaster-dev
SESSION_API_MINIO_SECRET_KEY=stackmaster-dev-secret
SESSION_API_MINIO_BUCKET_PRIVATE=private-bundles
SESSION_API_MINIO_BUCKET_PUBLIC=public-descriptors
SESSION_API_SNAPSHOT_ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
SESSION_API_SNAPSHOT_RETENTION_DAYS=30
SESSION_API_AUTO_SNAPSHOT_EVERY_REVISIONS=50

# ── 中期 M3 WP-78:宿主成绩同步只读接口的凭证 × 租户绑定白名单 ──
# (O-MP-6 / D-API-124;宿主凭证 → 租户集合绑定。集成用例以固定租户
#  `host-scores-tenant` 走 GET /host/scores 全链路;缺省 / 空 = 面整体 404。)
# ⚠ 分发改版 WP-96:它**同时**是启动地址链的锚租户(字典序最小项)⇒ 经启动地址
# 建立的会话其 tenantId 恒等于该值,而 create_session 的题目装载按
# (challengeId, version, tenantId) 强制过滤 ⇒ **要被启动地址链加载的题目必须
# 登记在这个租户下**(k6/seed-challenge.mjs 与 test/compose/helpers/topology.ts 同源)。
SESSION_API_HOST_TENANTS=host-scores-tenant

# ── 分发改版 WP-96:启动地址链(host 拓扑 = 宿主进程,发布在 13117)──
# 缺省(null)⇒ 签发面未启用 ⇒ POST /auth/launch-tickets 一律 404(fail-closed)。
# **该值必须是「浏览器 / 调用方实际访问的那个源」**,两条硬理由:
#  ① `launchUrl` 由它拼出(签发端点永不采信 Host 头)⇒ host 拓扑取宿主进程的
#     实际源 `http://127.0.0.1:13117`(与 test/compose/helpers/topology.ts 的
#     host 形态 BASE_URL 同源;不同源时换票用例会以「origin 与服务端配置不符」红);
#  ② 它同时是**页面 origin**:`sm_launch_grant` 是 `SameSite=Strict`,而
#     `localhost` 与 `127.0.0.1` 在浏览器眼里是**不同源** ⇒ 页面源与 API 源
#     必须是同一个字面 origin(容器拓扑的同一条纪律见 compose/app.yaml)。
SESSION_API_PUBLIC_ORIGIN=http://127.0.0.1:13117
# ⚠ 本文件**刻意不设** SESSION_API_PAGE_APP_DIR —— host 拓扑**默认不托管页面**
# (显式登记,不是遗漏):
#  - 该键是 fail-closed 的「显式配了就必须存在」:配了却指不到目录 = **拒绝启动**
#    (runtime.ts#resolvePageAppDir),而 apps/page-app/dist 是否存在取决于本机是否
#    构建过 page-app ⇒ 写死它会让「没构建页面的人连 test:compose / test:integration
#    都起不来」;
#  - 缺省语义(未设:存在即托管、不存在即不注册)才是 host 拓扑的正确形态;
#  - **后果(如实登记)**:host 拓扑下若未构建 page-app,换票**仍成功**(302 +
#    凭证 Cookie 全部成立)但 **`launchUrl` 贴进浏览器会 404**(没有页面可托管)
#    —— 这不影响任何自动化用例(它们只断言换票 302 与后续 REST / WSS),但**人工走查
#    页面形态必须走容器拓扑**(compose/app.yaml 已显式配该键 + bind mount),或用
#    `pnpm --filter @stackmaster/session-api dev:host`(它自带 PUBLIC_ORIGIN 与
#    页面目录装配)。
#  需要 host 拓扑也托管页面时:先构建 page-app,再导出
#    SESSION_API_PAGE_APP_DIR=<绝对路径>(此时服务拒绝启动是设计,不是缺陷)。

# ── 阶段六 WP-61:verifier(host 拓扑降级形态;与 deps.yaml 端口对应)──
# host 形态以依赖服务管理面凭证运行(容器拓扑为独立 verifier 角色与最小
# 授权 MinIO 用户——由 compose/verifier-db-init.sql 与 verifier-minio-init
# 授予;host 形态的角色治理降级如实登记,D-API-87)。
VERIFIER_HOST=127.0.0.1
VERIFIER_PORT=13100
VERIFIER_POSTGRES_URL=postgres://stackmaster:stackmaster-dev@127.0.0.1:15432/session_api
VERIFIER_MINIO_ENDPOINT=127.0.0.1
VERIFIER_MINIO_PORT=19000
VERIFIER_MINIO_ACCESS_KEY=stackmaster-dev
VERIFIER_MINIO_SECRET_KEY=stackmaster-dev-secret
VERIFIER_MINIO_BUCKET_PRIVATE=private-bundles
VERIFIER_MINIO_BUCKET_PUBLIC=public-descriptors
VERIFIER_POLL_INTERVAL_MS=500
