{
  "name": "@stackmaster/verifier",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "node --env-file=../session-api/compose/integration.env ./node_modules/vitest/vitest.mjs run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@stackmaster/challenge-schema": "workspace:*",
    "@stackmaster/protocol": "workspace:*",
    "fastify": "^5.12.3",
    "minio": "^8.0.7",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "vitest": "^4.1.11"
  }
}
