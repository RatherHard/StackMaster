{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackmaster.dev/schemas/session-action/v1/action-request.schema.json",
  "title": "ActionRequest",
  "x-sm-class": "boundary",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "clientSeq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "write_bytes"
            },
            "args": {
              "type": "object",
              "properties": {
                "addressHex": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{1,16}$"
                },
                "bytesHex": {
                  "type": "string",
                  "maxLength": 8192,
                  "pattern": "^(?:[0-9a-fA-F]{2})+$"
                }
              },
              "required": [
                "addressHex",
                "bytesHex"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "push"
            },
            "args": {
              "type": "object",
              "properties": {
                "valueHex": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{1,16}$"
                }
              },
              "required": [
                "valueHex"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pop"
            },
            "args": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "call"
            },
            "args": {
              "type": "object",
              "properties": {
                "targetHex": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{1,16}$"
                }
              },
              "required": [
                "targetHex"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ret"
            },
            "args": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "step"
            },
            "args": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "run_to_event"
            },
            "args": {
              "type": "object",
              "properties": {
                "pauseOn": {
                  "type": "string",
                  "enum": [
                    "read",
                    "write",
                    "call",
                    "ret",
                    "exception"
                  ]
                }
              },
              "required": [
                "pauseOn"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pause"
            },
            "args": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "undo"
            },
            "args": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "checkout_checkpoint"
            },
            "args": {
              "type": "object",
              "properties": {
                "checkpointId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                }
              },
              "required": [
                "checkpointId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "reset"
            },
            "args": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "create_checkpoint"
            },
            "args": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "protocolVersion",
    "sessionId",
    "clientSeq",
    "baseRevision",
    "idempotencyKey",
    "action"
  ],
  "additionalProperties": false
}
