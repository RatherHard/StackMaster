{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackmaster.dev/schemas/debug/v1/debug-variant-bundle.schema.json",
  "title": "DebugVariantBundle",
  "x-sm-class": "server-only",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "engineProcessProtocolVersion": {
      "type": "number",
      "const": 1
    },
    "challengeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "challengeContentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "vmProfileVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "aslrEnabled": {
      "type": "boolean"
    },
    "derivation": {
      "type": "object",
      "properties": {
        "algorithmId": {
          "type": "string",
          "const": "splitmix64-stream-v1"
        },
        "draws": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "baseAddresses": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "regionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "addressHex": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{1,16}$"
              }
            },
            "required": [
              "regionId",
              "addressHex"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "algorithmId",
        "draws"
      ],
      "additionalProperties": false
    },
    "memoryRegions": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "regionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "code",
              "global",
              "stack",
              "heap",
              "key",
              "custom"
            ]
          },
          "startAddressHex": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{1,16}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216,
            "multipleOf": 4096
          },
          "permissions": {
            "type": "string",
            "minLength": 1,
            "pattern": "^r?w?x?$"
          },
          "contentHex": {
            "type": "string",
            "maxLength": 33554432,
            "pattern": "^([0-9a-fA-F]{2})+$"
          },
          "isHidden": {
            "type": "boolean"
          }
        },
        "required": [
          "regionId",
          "kind",
          "startAddressHex",
          "byteLength",
          "permissions",
          "contentHex",
          "isHidden"
        ],
        "additionalProperties": false
      }
    },
    "registers": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(?!FLAG)[A-Z][A-Z0-9_]{0,15}$"
          },
          "valueHex": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{1,16}$"
          }
        },
        "required": [
          "name",
          "valueHex"
        ],
        "additionalProperties": false
      }
    },
    "canarySlots": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "kind": {
            "type": "string",
            "const": "canary"
          },
          "addressHex": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{1,16}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "hidden"
            ]
          },
          "containsSecret": {
            "type": "boolean"
          }
        },
        "required": [
          "objectId",
          "kind",
          "addressHex",
          "byteLength",
          "visibility",
          "containsSecret"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "containsSecret": {
                  "const": true
                }
              },
              "required": [
                "containsSecret"
              ]
            },
            "then": {
              "properties": {
                "visibility": {
                  "const": "hidden"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "engineProcessProtocolVersion",
    "challengeId",
    "challengeContentVersion",
    "vmProfileVersion",
    "aslrEnabled",
    "derivation",
    "memoryRegions",
    "registers"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "aslrEnabled": {
            "const": false
          }
        },
        "required": [
          "aslrEnabled"
        ]
      },
      "then": {
        "properties": {
          "derivation": {
            "not": {
              "required": [
                "baseAddresses"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aslrEnabled": {
            "const": true
          }
        },
        "required": [
          "aslrEnabled"
        ]
      },
      "then": {
        "properties": {
          "derivation": {
            "properties": {
              "draws": {
                "minimum": 1
              }
            }
          }
        }
      }
    }
  ]
}
