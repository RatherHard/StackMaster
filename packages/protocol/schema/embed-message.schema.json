          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "theme_changed"
        },
        "sessionId": {
          "type": "string",
          "minLength": 22,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "payload": {
          "type": "object",
          "properties": {
            "theme": {
              "type": "string",
              "enum": [
                "light",
                "dark",
                "auto"
              ]
            }
          },
          "required": [
            "theme"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "sessionId",
        "seq",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "language_changed"
        },
        "sessionId": {
          "type": "string",
          "minLength": 22,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "payload": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "minLength": 2,
              "maxLength": 35,
              "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
            }
          },
          "required": [
            "language"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "sessionId",
        "seq",
        "payload"
      ],
      "additionalProperties": false
    }
  ]
