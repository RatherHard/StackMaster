{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackmaster.dev/schemas/embed/v1/embed-message.schema.json",
  "title": "EmbedMessage",
  "x-sm-class": "boundary",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "hello"
        },
        "sessionId": {
          "type": "string",
          "minLength": 22,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "payload": {
          "type": "object",
          "properties": {
            "supportedVersions": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "capabilities": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "theme",
                  "language",
                  "auto_resize"
                ]
              }
            }
          },
          "required": [
            "supportedVersions",
            "capabilities"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "sessionId",
        "seq",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "ready"
        },
        "sessionId": {
          "type": "string",
          "minLength": 22,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "payload": {
          "type": "object",
          "properties": {
            "grantedCapabilities": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "theme",
                  "language",
                  "auto_resize"
                ]
              }
            },
            "config": {
              "type": "object",
              "properties": {
                "theme": {
                  "type": "string",
                  "enum": [
                    "light",
                    "dark",
                    "auto"
                  ]
                },
                "language": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 35,
                  "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
                }
              },
              "required": [
                "theme",
                "language"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "grantedCapabilities",
            "config"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "sessionId",
        "seq",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "height_changed"
        },
        "sessionId": {
          "type": "string",
          "minLength": 22,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "payload": {
          "type": "object",
          "properties": {
            "heightPx": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          "required": [
            "heightPx"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "sessionId",
        "seq",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
