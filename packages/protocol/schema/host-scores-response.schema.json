{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackmaster.dev/schemas/host-scores/v1/host-scores-response.schema.json",
  "title": "HostScoresResponse",
  "x-sm-class": "public",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "submissionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "challengeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "challengeVersion": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "success",
              "wrong_answer",
              "invalid_action",
              "program_crash",
              "memory_fault",
              "resource_limit",
              "timeout",
              "engine_error",
              "challenge_invalid",
              "replay_mismatch",
              "cancelled"
            ]
          },
          "decidedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "submissionId",
          "sessionId",
          "challengeId",
          "challengeVersion",
          "verdict",
          "decidedAt"
        ],
        "additionalProperties": false
      }
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "items",
    "nextCursor"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "items": {
            "maxItems": 0
          }
        },
        "required": [
          "items"
        ]
      },
      "then": {
        "properties": {
          "nextCursor": {
            "const": null
          }
        }
      }
    }
  ]
}
