{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackmaster.dev/schemas/session-action/v1/projection-policy.schema.json",
  "title": "ProjectionPolicy",
  "x-sm-class": "server-only",
  "type": "object",
  "properties": {
    "visibleRegions": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "visibleObjects": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "visibleRegisters": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$"
      }
    },
    "maxBytesPerRange": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "errorDetailLevel": {
      "type": "string",
      "enum": [
        "coarse",
        "educational"
      ]
    }
  },
  "required": [
    "visibleRegions",
    "visibleObjects",
    "visibleRegisters",
    "maxBytesPerRange",
    "errorDetailLevel"
  ],
  "additionalProperties": false
}
