{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackmaster.dev/schemas/session-action/v1/session-command-request.schema.json",
  "title": "SessionCommandRequest",
  "x-sm-class": "boundary",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "command": {
          "type": "string",
          "const": "create_session"
        },
        "payload": {
          "type": "object",
          "properties": {
            "challengeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "challengeVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "embedSessionId": {
              "type": "string",
              "minLength": 22,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "embedToken": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "challengeId",
            "challengeVersion",
            "embedSessionId",
            "embedToken"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "command",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "command": {
          "type": "string",
          "const": "sync_projection"
        },
        "payload": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "required": [
            "sessionId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "command",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "command": {
          "type": "string",
          "const": "list_checkpoints"
        },
        "payload": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "required": [
            "sessionId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "command",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "command": {
          "type": "string",
          "const": "submit"
        },
        "payload": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "required": [
            "sessionId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "command",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "command": {
          "type": "string",
          "const": "close_session"
        },
        "payload": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "required": [
            "sessionId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "command",
        "payload"
      ],
      "additionalProperties": false
    }
  ]
}
